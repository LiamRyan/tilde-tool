<UserControl x:Class="Tildetool.Time.Timekeep_Timeline2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:Tildetool.Time"
            xmlns:Shape="clr-namespace:Tildetool.Shape"
            xmlns:tildetool="clr-namespace:Tildetool.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Tool/Time/Timekeep+XSS.xaml"/>
                <ResourceDictionary Source="/Tool/Time/Timekeep+Timeline.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="DailyContent" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <TextBlock x:Name="DailyDate" Text="22/10/25 Sun" Width="160" Height="20" HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Top" FontFamily="Cascadia Code Light" Foreground="{StaticResource ColorTextFore}" FontSize="14" Margin="-1,1,0,0"/>
        <tildetool:FreeGrid Margin="160,18,60,25" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid x:Name="DailyRowHover" Background="#60248528" tildetool:FreeGrid.Left="25%" tildetool:FreeGrid.Width="20%"/>
            <TextBlock x:Name="DailyRowHoverL" tildetool:FreeGrid.Width="25%" Margin="0,-28,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" TextAlignment="Center" TextWrapping="NoWrap" FontFamily="Cascadia Code Light" Foreground="#60248528" FontSize="12">08<Run FontSize="8">00</Run></TextBlock>
            <TextBlock x:Name="DailyRowHoverM" tildetool:FreeGrid.Left="25%" tildetool:FreeGrid.Width="20%" Margin="-20,-28,-20,0" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center" TextWrapping="NoWrap" FontFamily="Cascadia Code Light" Foreground="#6048A548" FontSize="12">15<Run FontSize="8">00</Run></TextBlock>
            <TextBlock x:Name="DailyRowHoverR" Text="0800" tildetool:FreeGrid.Left="45%" tildetool:FreeGrid.Width="50" Margin="8,-28,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextAlignment="Center" TextWrapping="NoWrap" FontFamily="Cascadia Code Light" Foreground="#60248528" FontSize="12"/>
        </tildetool:FreeGrid>
        <Grid x:Name="HeaderRow" Margin="160,0,60,0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <ContentControl ContentTemplate="{StaticResource DailyHeaderCell}"></ContentControl>
        </Grid>
        <Grid x:Name="DailyDividers" Margin="160,16,60,17" HorizontalAlignment="Stretch">
            <ContentControl ContentTemplate="{StaticResource DailyDivider}"></ContentControl>
        </Grid>
        <tildetool:FreeGrid x:Name="DayBorder" Margin="160,20,60,0" HorizontalAlignment="Stretch">
            <Grid x:Name="DayBorderMin" Background="{StaticResource ColorDayBorderAlpha}" Margin="1,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" tildetool:FreeGrid.WidthPct="0.05"></Grid>
            <Grid x:Name="DayBorderMax" Background="{StaticResource ColorDayBorderAlpha}" Margin="1,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" tildetool:FreeGrid.LeftPct="0.95" tildetool:FreeGrid.WidthPct="0.05"></Grid>
        </tildetool:FreeGrid>
        <tildetool:FreeGrid x:Name="ScheduleGrid" Margin="160,20,60,0" HorizontalAlignment="Stretch">
            <ContentControl tildetool:FreeGrid.Left="20%" tildetool:FreeGrid.Width="5%" ContentTemplate="{StaticResource ScheduleEntry}"></ContentControl>
        </tildetool:FreeGrid>
        <StackPanel Orientation="Vertical" Margin="0,20,0,0">
            <StackPanel x:Name="DailyRows" Orientation="Vertical" Margin="0,0,0,0">
                <ContentControl ContentTemplate="{StaticResource DailyRow}"></ContentControl>
            </StackPanel>
            <Grid Background="{StaticResource ColorDividerAlpha}" Width="80" Height="1" HorizontalAlignment="Right"/>
            <StackPanel Width="50" Height="18" Margin="0,8,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock x:Name="SumTimeH" Text="8" TextAlignment="Left" FontFamily="Cascadia Code Light" Foreground="{StaticResource ColorTextFore}" FontSize="16" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="SumTimeM" Text="01" Margin="4,0,0,1" TextAlignment="Left" FontFamily="Cascadia Code Light" Foreground="{StaticResource ColorTextFore}" FontSize="12" VerticalAlignment="Bottom"/>
            </StackPanel>
        </StackPanel>
        <Grid x:Name="NowDividerGrid" Margin="160,18,60,25" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid Background="{StaticResource ColorNow}" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Grid.Column="0"/>
        </Grid>
        <Grid x:Name="NightLength" Margin="0,0,0,28" Width="150" Height="34" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <StackPanel Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock x:Name="NightLengthPre" Text="..." Margin="0,0,0,1" TextAlignment="Left" FontFamily="Cascadia Code Light" Foreground="{StaticResource ColorTextBack}" FontSize="10" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="NightLengthH" Text="8" TextAlignment="Left" FontFamily="Cascadia Code Light" Foreground="{StaticResource ColorTextBack}" FontSize="14" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="NightLengthM" Text="01" Margin="3,0,0,0.5" TextAlignment="Left" FontFamily="Cascadia Code Light" Foreground="{StaticResource ColorTextBack}" FontSize="10" VerticalAlignment="Bottom"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="TimeAreaHotspot" Margin="160,18,60,25" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource ColorNowAlpha2}" MouseEnter="TimeAreaHotspot_MouseEnter" MouseLeave="TimeAreaHotspot_MouseLeave" MouseMove="TimeAreaHotspot_MouseMove" MouseLeftButtonDown="TimeAreaHotspot_MouseLeftButtonDown" MouseLeftButtonUp="TimeAreaHotspot_MouseLeftButtonUp"/>
    </Grid>
</UserControl>
